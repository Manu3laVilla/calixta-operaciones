# Ruta al archivo JSON de credenciales del Service Account de Google
GOOGLE_CREDENTIALS_PATH=credentials/service_account.json

# ID de la hoja de Google Sheets (está en la URL: /d/ESTE_ID/edit)
SPREADSHEET_ID=tu_spreadsheet_id_aqui

# --- Alertas por correo (Gmail) ---
# Usa la cuenta calixtaa.co@gmail.com con una Contraseña de aplicación de Google
# Crear en: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=calixtaa.co@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion
ALERT_EMAIL_TO=calixtaa.co@gmail.com
